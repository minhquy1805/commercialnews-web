{
  "name": "commercialnews-web",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:admin": "npm --workspace @commercialnews/admin run dev",
    "build:admin": "npm --workspace @commercialnews/admin run build",
    "lint:admin": "npm --workspace @commercialnews/admin run lint",
    "preview:admin": "npm --workspace @commercialnews/admin run preview",

    "dev:website": "npm --workspace @commercialnews/website run dev",
    "build:website": "npm --workspace @commercialnews/website run build",
    "lint:website": "npm --workspace @commercialnews/website run lint",
    "start:website": "npm --workspace @commercialnews/website run start",

    "build": "npm run build:admin && npm run build:website",
    "lint": "npm run lint:admin && npm run lint:website"
  }
}